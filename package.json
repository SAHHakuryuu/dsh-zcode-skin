{
  "name": "@local/zcode-skin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ZCode-style skin for the Harness Web UI: ink surfaces, terminal-emerald accents, and an angular Z brand mark.",
  "license": "MIT",
  "author": "SAHHakuryuu",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "theme",
    "skin",
    "zcode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAHHakuryuu/dsh-zcode-skin.git"
  },
  "homepage": "https://github.com/SAHHakuryuu/dsh-zcode-skin#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
